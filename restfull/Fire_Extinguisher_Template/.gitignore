# ============================================
# Fire Extinguisher Management System
# .gitignore
# ============================================

# ============================================
# Environment Variables & Secrets
# ============================================
.env
.env.local
.env.development
.env.production
.env.test
*.env
!.env.example

# Credentials and sensitive files
ADMIN_CREDENTIALS.md
**/credentials.json
**/secrets.json
*.pem
*.key
*.cert

# ============================================
# Node.js & NPM
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Package manager lock files (optional - uncomment if needed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================
# Next.js (Frontend)
# ============================================
.next/
out/
build/
dist/
.vercel
.turbo

# Next.js cache
.next/cache/

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo
next-env.d.ts
*.d.ts.map

# ============================================
# Testing
# ============================================
coverage/
*.lcov
.nyc_output/
.jest/
test-results/
*.test.js.snap

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Operating System Files
# ============================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# IDEs & Editors
# ============================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist

# ============================================
# Database
# ============================================
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# PostgreSQL
*.sql.backup
*.dump

# ============================================
# Docker
# ============================================
docker-compose.override.yml
.dockerignore

# ============================================
# Temporary Files
# ============================================
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.bak
*.cache

# ============================================
# Build & Distribution
# ============================================
dist/
build/
*.tgz
*.zip
*.tar.gz

# ============================================
# Miscellaneous
# ============================================
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# ============================================
# Project Specific
# ============================================

# API Gateway
api-gateway/node_modules/
api-gateway/dist/
api-gateway/.env

# Services
services/*/node_modules/
services/*/dist/
services/*/.env

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env

# Database backups
database/backups/
*.sql.gz

# Uploaded files (if any)
uploads/
public/uploads/

# ============================================
# Keep These Files
# ============================================
!.env.example
!.gitkeep
!README.md
